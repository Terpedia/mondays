","eco":"ECO:0007120","papers":2},{"design":"in_vitro","eco":"ECO:0000181","papers":1}],"paper_count":5},{"claim_id":"cancer","statement":"Is being investigated for its relationship to cellular health and cancer.","evidence_level":"human_observational","basis":"Based on 3 human observational studies.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":3}],"paper_count":3}],"hypothesized_benefits":[{"claim_id":"antimicrobial","area":"Antimicrobial activity","hypothesis":"Researchers are exploring whether beta-phellandrene can effectively inhibit bacterial and fungal growth in human applications.","evidence_level":"human_observational","paper_count":27,"study_to_test_it":"A randomized, double-blind, placebo-controlled topical trial (Oxford level 1b) applying a standardized beta-phellandrene formulation to minor skin abrasions to measure bacterial colonization rates over two weeks.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":3},{"design":"animal","eco":"ECO:0007120","papers":4},{"design":"in_vitro","eco":"ECO:0000181","papers":14}]},{"claim_id":"antioxidant","area":"Oxidative stress","hypothesis":"If this bears out, beta-phellandrene might help neutralize free radicals and protect tissues from oxidative damage.","evidence_level":"human_observational","paper_count":13,"study_to_test_it":"A randomized controlled trial (Oxford level 1b) providing a dietary beta-phellandrene supplement to healthy adults, measuring serum biomarkers of oxidative stress like lipid peroxidation over 30 days.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":2},{"design":"animal","eco":"ECO:0007120","papers":3},{"design":"in_vitro","eco":"ECO:0000181","papers":1},{"design":"review","eco":"ECO:0000033","papers":2}]},{"claim_id":"insect","area":"Insect repellent","hypothesis":"Researchers are exploring whether it can serve as a viable, plant-derived alternative to synthetic bug sprays.","evidence_level":"human_observational","paper_count":8,"study_to_test_it":"A randomized, controlled field trial (Oxford level 1b) comparing topical beta-phellandrene against a standard DEET repellent and placebo, measuring mosquito landing rates on human volunteers over an 8-hour period.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1},{"design":"animal","eco":"ECO:0007120","papers":7}]},{"claim_id":"anti-inflammatory","area":"Inflammation","hypothesis":"Early work points toward the possibility that this terpene could help modulate inflammatory pathways.","evidence_level":"human_observational","paper_count":5,"study_to_test_it":"A randomized, placebo-controlled human trial (Oxford level 1b) measuring systemic inflammatory markers such as CRP and interleukins in subjects given a controlled oral dose of beta-phellandrene for four weeks.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1},{"design":"animal","eco":"ECO:0007120","papers":2},{"design":"in_vitro","eco":"ECO:0000181","papers":1}]}],"associated_conditions":[{"condition":"ulcerative colitis","mondo_id":"MONDO:0005101","relationship":"Detected in metabolomic studies of the condition."},{"condition":"metabolic dysfunction-associated steatotic liver disease","mondo_id":"MONDO:0013209","relationship":"Detected in metabolomic studies of the condition."},{"condition":"Solvents, acute toxic effect","mondo_id":null,"relationship":"Recorded as an occupational exposure hazard in industrial settings."}],"cautions":"In industrial settings, concentrated beta-phellandrene is recorded as an occupational exposure hazard related to solvent toxicity, and researchers are evaluating its genetic toxicity profile at high doses.","evidence_at_a_glance":"The best evidence so far for beta-phellandrene's effects comes from human observational work (Oxford level 2b), supported by a foundation of animal and in vitro research."}}
