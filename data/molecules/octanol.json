11644"]}],"pmids":["36235041","8911644"]},{"id":"cancer","label":"Cancer","papers":2,"designs":{"other":2},"evidence_level":"none_found","eco":{"id":"ECO:0000205","label":"curator inference"},"oxford":{"level":null,"label":"no evidence found"},"evidence_lines":[],"pmids":["8537890","20106561"]},{"id":"insect","label":"Insect repellent","papers":2,"designs":{"other":1,"animal":1},"evidence_level":"animal","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"mesh_publication_types":[],"papers":1,"pmids":["23732011"]}],"pmids":["25882403","23732011"]},{"id":"anti-inflammatory","label":"Anti-inflammatory","papers":1,"designs":{"other":1},"evidence_level":"none_found","eco":{"id":"ECO:0000205","label":"curator inference"},"oxford":{"level":null,"label":"no evidence found"},"evidence_lines":[],"pmids":["27146583"]}],"years":{"from":1975,"to":2026},"basis":"MeSH indexing and publication types of the most relevant PubMed records; counts are of papers in the sample, not findings.","vocabulary":{"evidence_type":"ECO (Evidence & Conclusion Ontology)","study_design":"MeSH Publication Types","strength":"Oxford CEBM 2009 levels","structure":"SEPIO assertion / evidence line / evidence item"},"search_url":"https://pubmed.ncbi.nlm.nih.gov/?term=Octanol%5BAll%20Fields%5D"},"summary":null,"evidence":"Measured in 3 of 6 MONDAYS hemp SKUs at 0.11–0.32% of total volatiles (0.022–0.064mg per chew).","trials":{"total":4,"matched_loosely":8,"studies":[{"nct_id":"NCT00102596","title":"Clinical Trial Characterizing the Bioavailability of 1-Octanol in Adults With Ethanol-responsive Essential Tremor","status":"COMPLETED","phases":["PHASE2"],"study_type":"INTERVENTIONAL","conditions":["Essential Tremor"],"interventions":["1-Octanol"],"sponsor":"National Institute of Neurological Disorders and Stroke (NINDS)","enrollment":21,"start_date":"2005-01","completion_date":"2009-09","summary":"OVERVIEW\n\nEssential tremor (ET) is a common movement disorder affecting 0.4% of the general population and up to 14% of people 65 years and older. Response to medications such as beta blockers and primidone may be of benefit, but are often accompanied by intolerable side effects. Response to ethanol, on the other hand, has a roughly 80% chance of significant tremor reduction, though daily use of this as a treatment has potentially serious medical, social, and legal consequences.\n\nThe leading hypothesis for ET pathophysiology is an unmasking of spontaneous oscillations originating in neurons of","url":"https://clinicaltrials.gov/study/NCT00102596"},{"nct_id":"NCT00080366","title":"Octanol to Treat Essential Tremor","status":"COMPLETED","phases":["PHASE2"],"study_type":"INTERVENTIONAL","conditions":["Essential Tremor"],"interventions":["1-Octanol"],"sponsor":"National Institute of Neurological Disorders and Stroke (NINDS)","enrollment":14,"start_date":"2004-03","completion_date":null,"summary":"This study will evaluate the effectiveness of 1-octanol, a substance similar to alcohol but less intoxicating, for treating essential tremor. Essential tremor is an involuntary shaking, usually of the hands, for which there is no satisfactory treatment. It affects about 1.4 percent of the general U.S. population, with the figure climbing to nearly 4 percent among people over 40. Results of two previous NIH studies have shown 1-octanol to be promising as a potential new treatment. This study will test the effectiveness of 1-octanol on essential tremor at doses lower than those given previously.","url":"https://clinicaltrials.gov/study/NCT00080366"},{"nct_id":"NCT00016679","title":"1-Octanol to Treat Essential Tremor","status":"COMPLETED","phases":["PHASE1"],"study_type":"INTERVENTIONAL","conditions":["Essential Tremor"],"interventions":["1-Octanol"],"sponsor":"National Institute of Neurological Disorders and Stroke (NINDS)","enrollment":42,"start_date":"2001-05","completion_date":null,"summary":"This study will determine the optimal dose of 1-octanol that will safely reduce tremors in patients with essential tremor-a disorder in which the hands, and sometimes the head, shake involuntarily. Current treatments may be ineffective or produce unwanted side effects. Ethanol (the chemical in beer and wine that causes intoxication) reduces tremor in many patients, but patients generally don't use it regularly because it interferes with daily activities. Laboratory studies show that 1-octanol, a drug that is similar to ethanol, may have the same beneficial effect on tremors with less likelihoo","url":"https://clinicaltrials.gov/study/NCT00016679"},{"nct_id":"NCT00001986","title":"1-Octanol to Treat Essential Tremor","status":"COMPLETED","phases":["PHASE1"],"study_type":"INTERVENTIONAL","conditions":["Essential Tremor"],"interventions":["1-Octanol"],"sponsor":"National Institute of Neurological Disorders and Stroke (NINDS)","enrollment":12,"start_date":"2000-01","completion_date":null,"summary":"This study will evaluate the safety and effectiveness of the food additive 1-octanol for treating essential tremor. This disorder, which is an involuntary shaking, usually of the hands, has no satisfactory treatment. It affects more than one of every 100 people in the general population, with the figure climbing to nearly 4 in every hundred among people over 40 years old. In animal studies, 1-octanol reduced chemically induced tremors in rats. This study will test the effects of the accepted daily intake of 1-octanol (1 milligram per kilogram of body weight) on essential tremor in humans.\n\nPat","url":"https://clinicaltrials.gov/study/NCT00001986"}],"source":"ClinicalTrials.gov","search_url":"https://clinicaltrials.gov/search?intr=Octanol"},"is_terpenoid":false,"consumer_summary":{"model":"gemini-3.1-pro-preview","generated":"2026-09-11","what_it_is":"Octanol is a naturally occurring fatty alcohol that acts as a chemical messenger and metabolite in plants and bacteria. While you might encounter it in trace amounts in certain foods and essential oils, it is most famous in the laboratory as the universal standard for testing how well other molecules dissolve in fats versus water.","found_in":"It is found naturally in familiar foods like corn, mandarin oranges, and shiitake mushrooms, as well as aromatic herbs like thyme and marigold.","why_researchers_care":"Researchers are fascinated by octanol because it is much more than a laboratory solvent; it shows surprising interactions with the human nervous system. The strongest evidence comes from human clinical trials (Oxford level 1b) testing its ability to calm essential tremors. Beyond neurology, scientists are also exploring its potential as an antimicrobial agent and insect repellent in early animal and bench studies.","structure_function":[{"claim_id":"antimicrobial","statement":"Early animal research points toward octanol having antimicrobial properties.","evidence_level":"animal","basis":"This rests on 2 papers, including early animal models.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}],"paper_count":2},{"claim_id":"insect","statement":"Early animal work suggests octanol may act as a natural insect repellent.","evidence_level":"animal","basis":"This is based on 2 papers involving animal research.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}],"paper_count":2}],"hypothesized_benefits":[{"claim_id":"antimicrobial","area":"Infection control","hypothesis":"Researchers are exploring whether octanol could be developed into a novel antimicrobial agent to fight bacterial or fungal infections.","evidence_level":"animal","paper_count":2,"study_to_test_it":"A Phase 1 human safety and dosing trial applying a topical octanol formulation to healthy volunteers to measure skin tolerability and bacterial load reduction over two weeks.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}]},{"claim_id":"insect","area":"Insect repellent","hypothesis":"Early animal work points toward octanol acting as a natural insect repellent, and researchers are curious if it could effectively protect humans from vector-borne pests.","evidence_level":"animal","paper_count":2,"study_to_test_it":"A randomized, double-blind human field trial comparing a topical octanol spray against a standard DEET repellent to measure the duration of mosquito bite protection over 8 hours.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}]},{"claim_id":"cancer","area":"Cancer biology","hypothesis":"Scientists are investigating whether octanol might play a role in cancer biology, though no direct evidence of a benefit has been found yet.","evidence_level":"none_found","paper_count":2,"study_to_test_it":"An in vitro study exposing various human cancer cell lines to octanol to measure cell viability, proliferation, and apoptosis markers over 72 hours.","eco":{"id":"ECO:0000205","label":"curator inference"},"oxford":{"level":null,"label":"no evidence found"},"evidence_lines":[]},{"claim_id":"anti-inflammatory","area":"Inflammation","hypothesis":"Researchers are exploring whether octanol might have anti-inflammatory properties that could soothe tissue irritation.","evidence_level":"none_found","paper_count":1,"study_to_test_it":"An animal study using a murine model of inflammation to measure cytokine levels and tissue swelling after topical or oral administration of octanol.","eco":{"id":"ECO:0000205","label":"curator inference"},"oxford":{"level":null,"label":"no evidence found"},"evidence_lines":[]}],"associated_conditions":[{"condition":"ulcerative colitis","mondo_id":"MONDO:0005101","relationship":"Detected in metabolomic studies of ulcerative colitis."},{"condition":"celiac disease","mondo_id":"MONDO:0005130","relationship":"Detected in metabolomic studies of celiac disease."},{"condition":"autism","mondo_id":"MONDO:0005260","relationship":"Detected in metabolomic studies of autism."},{"condition":"Solvents, acute toxic effect","mondo_id":null,"relationship":"Occupational exposure hazard in industrial settings."}],"cautions":"In industrial settings, occupational exposure to concentrated octanol as a solvent is recognized as an acute toxic hazard.","evidence_at_a_glance":"The strongest evidence for octanol comes from human clinical trials (Oxford level 1b) testing it for essential tremor, while research into its antimicrobial and insect-repelling properties remains at the animal and laboratory stage."}}
