007120","label":"animal model system study evidence"},"mesh_publication_types":[],"papers":3,"pmids":["36442761","25097889","22728247"]}],"pmids":["36442761","25097889","22728247"]}],"years":{"from":1976,"to":2026},"basis":"MeSH indexing and publication types of the most relevant PubMed records; counts are of papers in the sample, not findings.","vocabulary":{"evidence_type":"ECO (Evidence & Conclusion Ontology)","study_design":"MeSH Publication Types","strength":"Oxford CEBM 2009 levels","structure":"SEPIO assertion / evidence line / evidence item"},"search_url":"https://pubmed.ncbi.nlm.nih.gov/?term=gamma-Muurolene%5BAll%20Fields%5D"},"summary":null,"evidence":"Measured in 5 of 6 MONDAYS hemp SKUs at 0.1–0.35% of total volatiles (0.02–0.07mg per chew).","trials":{"total":0,"matched_loosely":0,"studies":[],"source":"ClinicalTrials.gov","search_url":"https://clinicaltrials.gov/search?intr=gamma-Muurolene"},"is_terpenoid":true,"consumer_summary":{"model":"gemini-3.1-pro-preview","generated":"2026-09-11","what_it_is":"Gamma-muurolene is a sesquiterpene, a class of aromatic molecules built from three isoprene units that often give plants their complex, woody, or spicy scents. In daily life, you are most likely to encounter it in the rich aromas of essential oils, certain fruits, and the bitter, floral notes of craft beers.","found_in":"This compound is naturally produced by a wide variety of familiar plants, including hops (Humulus lupulus), ylang-ylang (Cananga odorata), and yarrow (Achillea millefolium). It is also found in the essential oils of Japanese cedar and angelica root.","why_researchers_care":"Researchers are drawn to gamma-muurolene for its prominent role in the chemical defense systems of plants, particularly its ability to fend off microbes and oxidative stress. The scientific community is actively exploring how these protective properties might translate to human health and natural product development. The strongest evidence so far comes from human observational studies (Oxford level 2b), which have frequently detected this molecule in the complex botanical extracts used in traditional medicine and modern pharmacology.","structure_function":[{"claim_id":"antimicrobial","statement":"Early human observational work points toward gamma-muurolene as a component of botanical extracts that may support the body's natural defenses against microbes.","evidence_level":"human_observational","basis":"This rests on 21 papers, including human observational and in vitro studies.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":5},{"design":"animal","eco":"ECO:0007120","papers":4},{"design":"in_vitro","eco":"ECO:0000181","papers":9}],"paper_count":21},{"claim_id":"antioxidant","statement":"Observational studies suggest it may support cellular health by acting as an antioxidant.","evidence_level":"human_observational","basis":"This is based on 15 papers spanning human observational, animal, and lab research.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1},{"design":"animal","eco":"ECO:0007120","papers":3},{"design":"in_vitro","eco":"ECO:0000181","papers":1}],"paper_count":15},{"claim_id":"anti-inflammatory","statement":"It is being studied for its potential to support healthy inflammatory responses.","evidence_level":"human_observational","basis":"This rests on 9 papers, primarily animal models alongside human observational data.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1},{"design":"animal","eco":"ECO:0007120","papers":7}],"paper_count":9},{"claim_id":"insect","statement":"Animal research points toward its potential utility as a natural insect repellent.","evidence_level":"animal","basis":"This is supported by 5 animal studies.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":5}],"paper_count":5},{"claim_id":"pain","statement":"Early work points toward a potential role in supporting physical comfort and soothing pain.","evidence_level":"animal","basis":"This rests on 3 animal studies.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":3}],"paper_count":3}],"hypothesized_benefits":[{"claim_id":"antimicrobial","area":"Bacterial defense","hypothesis":"Researchers are exploring whether isolated gamma-muurolene can effectively neutralize challenging or drug-resistant bacteria on the skin.","evidence_level":"human_observational","paper_count":21,"study_to_test_it":"A randomized, double-blind clinical trial comparing a standardized topical gamma-muurolene preparation against a placebo for mild bacterial skin imbalances over two weeks.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":5},{"design":"animal","eco":"ECO:0007120","papers":4},{"design":"in_vitro","eco":"ECO:0000181","papers":9}]},{"claim_id":"anti-inflammatory","area":"Inflammation modulation","hypothesis":"If early findings bear out, this molecule might help modulate inflammatory pathways in the body, offering a natural way to support tissue recovery.","evidence_level":"human_observational","paper_count":9,"study_to_test_it":"A randomized controlled trial measuring serum inflammatory markers (like CRP) in healthy adults taking a standardized gamma-muurolene supplement versus placebo for 30 days.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1},{"design":"animal","eco":"ECO:0007120","papers":7}]},{"claim_id":"cancer","area":"Cellular protection","hypothesis":"Scientists are investigating whether the presence of gamma-muurolene in certain diets or extracts plays a role in cellular protection and maintaining healthy cell cycles.","evidence_level":"human_observational","paper_count":5,"study_to_test_it":"A randomized controlled trial evaluating the effect of gamma-muurolene supplementation on oxidative stress and cellular health biomarkers in a human cohort over six months.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":5}]},{"claim_id":"pain","area":"Analgesia","hypothesis":"Early animal work points toward a potential role in soothing pain, raising the question of whether it could be used in natural analgesic formulations for joint or muscle discomfort.","evidence_level":"animal","paper_count":3,"study_to_test_it":"A Phase I/II human clinical trial assessing the safety and pain-relieving efficacy of a gamma-muurolene topical cream in patients with mild osteoarthritis over four weeks.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":3}]}],"associated_conditions":[],"cautions":null,"evidence_at_a_glance":"Best evidence so far is human observational work (Oxford 2b); most of the rest is animal and lab research."}}
