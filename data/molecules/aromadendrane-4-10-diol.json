nce"},"mesh_publication_types":[],"papers":1,"pmids":["26593432"]}],"pmids":["26593432"]}],"years":{"from":2005,"to":2021},"basis":"MeSH indexing and publication types of the most relevant PubMed records; counts are of papers in the sample, not findings.","vocabulary":{"evidence_type":"ECO (Evidence & Conclusion Ontology)","study_design":"MeSH Publication Types","strength":"Oxford CEBM 2009 levels","structure":"SEPIO assertion / evidence line / evidence item"},"search_url":"https://pubmed.ncbi.nlm.nih.gov/?term=Aromadendrane-4%2C10-diol%5BAll%20Fields%5D"},"summary":null,"evidence":"Measured in 1 of 6 MONDAYS hemp SKUs at 0.07% of total volatiles (0.014mg per chew).","trials":{"total":0,"matched_loosely":0,"studies":[],"source":"ClinicalTrials.gov","search_url":"https://clinicaltrials.gov/search?intr=Aromadendrane-4%2C10-diol"},"is_terpenoid":false,"consumer_summary":{"model":"gemini-3.1-pro-preview","generated":"2026-09-11","what_it_is":"Aromadendrane-4,10-diol is a sesquiterpene alcohol, a member of the large family of aromatic compounds that give many plants their distinct scents and flavors. While its specific aroma profile is not widely documented for consumers, people naturally encounter this molecule when consuming certain traditional herbs and botanicals.","found_in":"It has been identified in familiar botanicals like ginseng (Panax ginseng) and the chaste tree (Vitex agnus-castus), as well as in marine organisms like South China Sea gorgonians.","why_researchers_care":"Researchers are drawn to aromadendrane-4,10-diol for its potential to interact with the nervous system, particularly its ability to stimulate the growth of new neural connections in early models. While the highest level of evidence for this molecule overall is human observational work (Oxford level 2b) regarding its antimicrobial properties, scientists are highly interested in what its neurological effects could mean for cognitive health and memory.","structure_function":[{"claim_id":"antimicrobial","statement":"Aromadendrane-4,10-diol may support the body's natural defenses against certain microbes.","evidence_level":"human_observational","basis":"This is based on one human observational study.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1}],"paper_count":1},{"claim_id":"antioxidant","statement":"Early work points toward antioxidant properties that may help neutralize free radicals.","evidence_level":"animal","basis":"This rests on a single animal study.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}],"paper_count":1},{"claim_id":"neuroprotection","statement":"The molecule is being studied for its potential to support brain health and protect neural pathways.","evidence_level":"animal","basis":"This is supported by one animal study evaluating memory and brain function.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}],"paper_count":1}],"hypothesized_benefits":[{"claim_id":"neuroprotection","area":"Cognitive Function and Memory","hypothesis":"Researchers are exploring whether aromadendrane-4,10-diol can protect against memory impairment and encourage the growth of new neurons (neuritogenesis). If this bears out, it could offer a novel botanical approach to supporting long-term cognitive health.","evidence_level":"animal","paper_count":1,"study_to_test_it":"A randomized, double-blind, placebo-controlled human trial measuring cognitive performance and memory retention over six months in older adults using a standardized extract.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}]},{"claim_id":"antimicrobial","area":"Microbial Defense","hypothesis":"Scientists are investigating the compound's ability to act as an antimicrobial agent when isolated from natural extracts.","evidence_level":"human_observational","paper_count":1,"study_to_test_it":"A randomized controlled trial applying a standardized topical or oral dose to evaluate specific microbial clearance rates compared to a placebo.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1}]}],"associated_conditions":[{"condition":"Alzheimer disease","mondo_id":"MONDO:0004975","relationship":"studied as an intervention for in animal models"}],"cautions":null,"evidence_at_a_glance":"Best evidence so far is human observational work (Oxford 2b) for antimicrobial properties; most of the rest, including the exciting neurological research, is based on animal and lab studies."}}
