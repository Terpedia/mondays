ies.","evidence_level":"none_found","basis":"This rests on 4 preliminary papers, including early lab and animal models.","eco":null,"oxford":null,"evidence_lines":[],"paper_count":4},{"claim_id":"antioxidant","statement":"α-Santalene is being studied for potential antioxidant activity.","evidence_level":"none_found","basis":"This is based on 4 early-stage papers.","eco":null,"oxford":null,"evidence_lines":[],"paper_count":4},{"claim_id":"insect","statement":"Early animal work points toward a potential role as an insect repellent.","evidence_level":"none_found","basis":"This is based on 2 animal-model papers.","eco":null,"oxford":null,"evidence_lines":[],"paper_count":2}],"hypothesized_benefits":[{"claim_id":"digestive","area":"Digestive health","hypothesis":"Researchers are exploring whether α-santalene might support digestive function, though it remains an open question.","evidence_level":"none_found","paper_count":1,"study_to_test_it":"A controlled animal study measuring gastrointestinal transit time and mucosal integrity in a mammalian model.","eco":null,"oxford":null,"evidence_lines":[]},{"claim_id":"cancer","area":"Cellular health","hypothesis":"Early exploration is looking into how this molecule interacts with cellular pathways, which could eventually inform broader health research if it bears out.","evidence_level":"none_found","paper_count":1,"study_to_test_it":"A rigorous in vitro study using human cell lines to measure apoptosis and cell proliferation markers after exposure to α-santalene.","eco":null,"oxford":null,"evidence_lines":[]}],"associated_conditions":[],"cautions":null,"evidence_at_a_glance":"The current literature is primarily focused on bioengineering and fermentation, with no formal clinical evidence (Oxford level none found) yet established for health claims."},"summary":null,"evidence":"Measured in 6 of 6 MONDAYS hemp SKUs at 0.07–0.25% of total volatiles (0.014–0.05mg per chew).","trials":{"total":0,"matched_loosely":0,"studies":[],"source"