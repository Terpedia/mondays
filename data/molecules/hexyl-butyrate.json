rch"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}]},{"claim_id":"cancer","area":"Cancer","hypothesis":"Scientists are investigating whether exposure to or consumption of hexyl butyrate is associated with altered cancer risks or cellular protective effects.","evidence_level":"human_observational","paper_count":1,"study_to_test_it":"A large-scale, long-term prospective human cohort study tracking dietary or occupational hexyl butyrate exposure and correlating it with cancer incidence over a decade.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1}]},{"claim_id":"insect","area":"Insect repellent","hypothesis":"Given its role in insect communication, researchers are exploring whether it could serve as an effective, natural mosquito or pest repellent for humans.","evidence_level":"animal","paper_count":1,"study_to_test_it":"A human volunteer 'arm-in-cage' test measuring the protection time and bite-reduction rate of a topical hexyl butyrate lotion against Aedes and Anopheles mosquitoes compared to a standard DEET control.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}]}],"associated_conditions":[{"condition":"ulcerative colitis","mondo_id":"MONDO:0005101","relationship":"detected in metabolomic studies of"},{"condition":"autism","mondo_id":"MONDO:0005260","relationship":"detected in metabolomic studies of"},{"condition":"autism spectrum disorder","mondo_id":"MONDO:0005258","relationship":"detected in metabolomic studies of"},{"condition":"Solvents, acute toxic effect","mondo_id":null,"relationship":"occupational exposure hazard"}],"cautions":"In industrial or occupational settings, concentrated exposure to hexyl butyrate as a solvent can present an acute toxic hazard, though this is not a concern at typical dietary or fragrance levels.","evidence_at_a_glance":"Best evidence so far is human observational work (Oxford 2b) regarding its antimicrobial and cellular associations; most of the remaining research focuses on animal studies and insect behavior."}}
