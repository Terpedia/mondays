h or animal research"},"evidence_lines":[{"design":"animal","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"mesh_publication_types":[],"papers":1,"pmids":["36552848"]}],"pmids":["36552848"]}],"years":{"from":1985,"to":2026},"basis":"MeSH indexing and publication types of the most relevant PubMed records; counts are of papers in the sample, not findings.","vocabulary":{"evidence_type":"ECO (Evidence & Conclusion Ontology)","study_design":"MeSH Publication Types","strength":"Oxford CEBM 2009 levels","structure":"SEPIO assertion / evidence line / evidence item"},"search_url":"https://pubmed.ncbi.nlm.nih.gov/?term=Fenchone%5BAll%20Fields%5D"},"summary":null,"evidence":"Measured in 6 of 6 MONDAYS hemp SKUs at 0.06–0.17% of total volatiles (0.012–0.034mg per chew).","trials":{"total":0,"matched_loosely":0,"studies":[],"source":"ClinicalTrials.gov","search_url":"https://clinicaltrials.gov/search?intr=Fenchone"},"is_terpenoid":true,"consumer_summary":{"model":"gemini-3.1-pro-preview","generated":"2026-09-11","what_it_is":"Fenchone is a cyclic terpene ketone responsible for the distinctive, slightly bitter, and camphor-like aroma of fennel. As a natural plant metabolite, it contributes to the scent and flavor profiles of several aromatic herbs and trees. You most likely encounter it when cooking with fennel seeds or smelling certain varieties of lavender.","found_in":"Fenchone is most famously found in fennel (Foeniculum vulgare), but it is also present in French lavender (Lavandula stoechas) and northern white cedar (Thuja occidentalis).","why_researchers_care":"Researchers are drawn to fenchone for its broad biological activity, particularly its potential as a natural antimicrobial and antioxidant agent. They are actively exploring how this terpene interacts with cellular pathways, including its effects on inflammation, cholesterol regulation, and gut health. The strongest evidence so far comes from human observational studies (Oxford level 2b), which are guiding ongoing laboratory and animal research into its therapeutic potential.","structure_function":[{"claim_id":"antimicrobial","statement":"Fenchone is being studied for its potential to support the body's natural defenses against microbes.","evidence_level":"human_observational","basis":"This rests on 42 papers, including 14 human observational studies and 14 in vitro experiments.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":14},{"design":"animal","eco":"ECO:0007120","papers":5},{"design":"in_vitro","eco":"ECO:0000181","papers":14},{"design":"review","eco":"ECO:0000033","papers":2}],"paper_count":42},{"claim_id":"antioxidant","statement":"Early work points toward fenchone having antioxidant properties that may help neutralize free radicals.","evidence_level":"human_observational","basis":"This is based on 19 papers, primarily human observational and animal research.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":5},{"design":"animal","eco":"ECO:0007120","papers":5},{"design":"in_vitro","eco":"ECO:0000181","papers":3},{"design":"review","eco":"ECO:0000033","papers":2}],"paper_count":19},{"claim_id":"anti-inflammatory","statement":"The molecule is being explored for its ability to support healthy inflammatory responses.","evidence_level":"human_observational","basis":"This rests on 3 papers, including human observational and animal research.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1},{"design":"animal","eco":"ECO:0007120","papers":2}],"paper_count":3}],"hypothesized_benefits":[{"claim_id":"anti-inflammatory","area":"Inflammation and Gut Health","hypothesis":"Researchers are exploring whether fenchone can modulate macrophage polarization and cholesterol homeostasis to support healthy inflammatory responses, particularly in the context of irritable bowel syndrome.","evidence_level":"human_observational","paper_count":3,"study_to_test_it":"A randomized, double-blind clinical trial measuring systemic inflammatory markers and gut motility in humans with constipation-predominant irritable bowel syndrome over 8 weeks.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1},{"design":"animal","eco":"ECO:0007120","papers":2}]},{"claim_id":"insect","area":"Insect Repellent","hypothesis":"Early work points toward fenchone inhibiting mosquito olfaction, raising the question of whether it could be developed into a highly effective, plant-based insect repellent.","evidence_level":"human_observational","paper_count":13,"study_to_test_it":"A randomized, double-blind human field trial comparing topical fenchone formulations against standard DEET repellents, measuring mosquito landing rates over an 8-hour exposure period.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":3},{"design":"animal","eco":"ECO:0007120","papers":10}]},{"claim_id":"pain","area":"Pain Relief","hypothesis":"Animal research is exploring whether fenchone might support physical comfort and pain relief, though the exact mechanisms remain an open question.","evidence_level":"animal","paper_count":1,"study_to_test_it":"A phase I/II randomized, placebo-controlled human trial evaluating the analgesic effects of a standardized fenchone preparation on acute pain thresholds using quantitative sensory testing.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1}]},{"claim_id":"cancer","area":"Cellular Health","hypothesis":"Researchers are exploring whether fenchone interacts with cellular pathways involved in abnormal cell growth. If this bears out, it could offer insights into how dietary terpenes support long-term cellular health.","evidence_level":"human_observational","paper_count":5,"study_to_test_it":"A randomized, placebo-controlled human trial measuring specific biomarkers of cellular proliferation and oxidative stress in a high-risk cohort over six months.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":5}]}],"associated_conditions":[{"condition":"Solvents, acute toxic effect","mondo_id":null,"relationship":"Recorded as an occupational exposure hazard in industrial contexts."}],"cautions":"In concentrated industrial forms, fenchone is classified as an occupational exposure hazard, though this does not apply to normal dietary consumption of fennel or herbs.","evidence_at_a_glance":"Best evidence so far is human observational work (Oxford 2b); most of the rest is animal and lab research focusing on its antimicrobial and antioxidant properties."}}
