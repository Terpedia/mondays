pmids":["27628733","21592665"]},{"id":"sleep","label":"Sleep and sedation","papers":1,"designs":{"human_observational":1},"evidence_level":"human_observational","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"mesh_publication_types":["Observational Study"],"papers":1,"pmids":["23177536"]}],"pmids":["23177536"]}],"years":{"from":1946,"to":2026},"basis":"MeSH indexing and publication types of the most relevant PubMed records; counts are of papers in the sample, not findings.","vocabulary":{"evidence_type":"ECO (Evidence & Conclusion Ontology)","study_design":"MeSH Publication Types","strength":"Oxford CEBM 2009 levels","structure":"SEPIO assertion / evidence line / evidence item"},"search_url":"https://pubmed.ncbi.nlm.nih.gov/?term=Pelargonic%20acid%5BAll%20Fields%5D"},"summary":null,"evidence":"Measured in 1 of 6 MONDAYS hemp SKUs at 0.1% of total volatiles (0.02mg per chew).","trials":{"total":0,"matched_loosely":0,"studies":[],"source":"ClinicalTrials.gov","search_url":"https://clinicaltrials.gov/search?intr=Pelargonic%20acid"},"is_terpenoid":false,"consumer_summary":{"model":"gemini-3.1-pro-preview","generated":"2026-09-11","what_it_is":"Pelargonic acid, also known as nonanoic acid, is a medium-chain saturated fatty acid that occurs naturally in the essential oils of certain plants. In its pure form, it has a distinct, somewhat waxy and cheesy odor. Beyond its natural presence in the environment, you might encounter it as an active ingredient in natural herbicides or as a building block in the manufacturing of lacquers and plastics.","found_in":"It is famously found in the oil of pelargonium (geraniums), and has also been identified in familiar botanicals like Glycyrrhiza glabra (licorice root), Agave americana, and Althaea officinalis (marshmallow plant).","why_researchers_care":"Researchers are drawn to pelargonic acid for its potent biological activity, particularly its ability to act as a natural antifungal and antimicrobial agent. Because it is a naturally occurring fatty acid that disrupts cell membranes in certain pests and microbes, scientists are exploring its potential as a safer alternative to synthetic chemicals in both agriculture and dermatology. The strongest evidence for its effects comes from human trials (Oxford level 1b) investigating its antimicrobial properties.","structure_function":[{"claim_id":"antimicrobial","statement":"Pelargonic acid may support the body's natural defenses against certain microbes and fungi.","evidence_level":"human_trials","basis":"This is supported by 11 papers, including at least one individual randomised trial.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"1b","label":"individual randomised trial"},"evidence_lines":[{"design":"rct","eco":"ECO:0000180","papers":1},{"design":"human_observational","eco":"ECO:0000180","papers":3},{"design":"animal","eco":"ECO:0007120","papers":1},{"design":"in_vitro","eco":"ECO:0000181","papers":4}],"paper_count":11},{"claim_id":"sleep","statement":"It is being explored for a potential role in supporting normal sleep patterns.","evidence_level":"human_observational","basis":"This observation comes from a single human cohort study.","eco":{"id":"ECO:0000180","label":"clinical study evidence"},"oxford":{"level":"2b","label":"individual cohort or observational study"},"evidence_lines":[{"design":"human_observational","eco":"ECO:0000180","papers":1}],"paper_count":1},{"claim_id":"anti-inflammatory","statement":"Early work points toward a potential role in supporting healthy inflammatory responses.","evidence_level":"animal","basis":"This rests on 4 animal studies.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":4}],"paper_count":4},{"claim_id":"antioxidant","statement":"The molecule is being studied for potential antioxidant properties that may help protect cells from oxidative stress.","evidence_level":"animal","basis":"This is based on 4 papers, primarily bench and animal research.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":3}],"paper_count":4}],"hypothesized_benefits":[{"claim_id":"insect","area":"Insect repellent","hypothesis":"Early animal work points toward its potential as a natural insect repellent, raising the question of whether it could be formulated into effective, plant-based bug sprays for human use.","evidence_level":"animal","paper_count":2,"study_to_test_it":"A randomized, double-blind human topical trial applying a pelargonic acid formulation versus a DEET control to the forearms of volunteers, measuring the duration of complete protection against mosquito landings in a controlled flight chamber.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":2}]},{"claim_id":"cancer","area":"Cellular health","hypothesis":"Researchers are exploring whether pelargonic acid can influence cellular pathways involved in abnormal cell growth, which could eventually inform new approaches to cancer research.","evidence_level":"animal","paper_count":2,"study_to_test_it":"A Phase I human safety and pharmacokinetic trial administering a controlled oral dose of pelargonic acid to healthy volunteers to measure its absorption, metabolism, and safety profile over 14 days.","eco":{"id":"ECO:0007120","label":"animal model system study evidence"},"oxford":{"level":"5","label":"bench or animal research"},"evidence_lines":[{"design":"animal","eco":"ECO:0007120","papers":1},{"design":"in_vitro","eco":"ECO:0000181","papers":1}]}],"associated_conditions":[{"condition":"schizophrenia","mondo_id":"MONDO:0005090","relationship":"detected in metabolomic studies of"},{"condition":"colorectal cancer","mondo_id":"MONDO:0005575","relationship":"detected in metabolomic studies of"},{"condition":"Crohn disease","mondo_id":"MONDO:0005011","relationship":"detected in metabolomic studies of"},{"condition":"ulcerative colitis","mondo_id":"MONDO:0005101","relationship":"detected in metabolomic studies of"}],"cautions":"In concentrated forms, pelargonic acid is a known skin and eye irritant used as a commercial herbicide, so it should not be applied directly to the skin or ingested outside of normal dietary amounts.","evidence_at_a_glance":"Best evidence so far is from human trials (Oxford 1b) for its antimicrobial effects, while most other research into its health properties remains in the early animal and laboratory stages."}}
